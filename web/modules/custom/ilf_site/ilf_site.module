<?php

declare(strict_types=1);

/**
 * Implements hook_views_query_alter().
 */
function ilf_site_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if ($view->id() !== 'product_resources' || !method_exists($query, 'ensureTable')) {
    return;
  }

  $type = (int) \Drupal::request()->query->get('type', 0);
  if ($type <= 0) {
    return;
  }

  $alias = $query->ensureTable('node__field_resource_category');
  $query->addWhere(1, "$alias.field_resource_category_target_id", $type, '=');
}
