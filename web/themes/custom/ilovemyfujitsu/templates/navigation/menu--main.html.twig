{% import _self as menus %}

{{ menus.menu_links(items, 0) }}

{% macro menu_links(items, menu_level) %}
  {% if items %}
    <ul class="{{ menu_level == 0 ? 'fujitsu-menu' : 'fujitsu-menu__sub' }}">
      {% for item in items %}
        <li{{ item.attributes.addClass('fujitsu-menu__item') }}>
          <a class="fujitsu-menu__link" href="{{ item.url }}">{{ item.title }}</a>
          {% if item.below %}
            {{ _self.menu_links(item.below, menu_level + 1) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
