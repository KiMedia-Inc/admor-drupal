<article{{ attributes.addClass('ilf-structured-node', 'ilf-structured-node--profile') }}>
  <header class="fujitsu-page-hero">
    <div class="container">
      <p class="fujitsu-eyebrow">Faces of Fujitsu</p>
      <h1>{{ label }}</h1>
    </div>
  </header>

  <div class="fujitsu-page-body">
    <div class="container">
      <div class="ilf-detail-card ilf-detail-card--profile">
        {% if node.field_profile_image.target_id and node.field_profile_image.entity %}
          <img
            src="{{ file_url(node.field_profile_image.entity.uri.value) }}"
            alt="{{ node.field_profile_image.alt ?: (label|render|striptags ~ ' - Faces of Fujitsu') }}"
          >
        {% endif %}
        <div class="ilf-detail-card__main">
          {% if node.field_role.value %}
            <p class="ilf-kicker">{{ node.field_role.value }}</p>
          {% endif %}
          {{ content.body }}
        </div>
      </div>
    </div>
  </div>
</article>
