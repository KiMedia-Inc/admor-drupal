<article{{ attributes.addClass('ilf-structured-node', 'ilf-structured-node--news') }}>
  <header class="fujitsu-page-hero">
    <div class="container">
      <p class="fujitsu-eyebrow">Fujitsu Hawaii Update</p>
      <h1>{{ label }}</h1>
    </div>
  </header>

  <div class="fujitsu-page-body">
    <div class="container">
      <div class="ilf-detail-card ilf-news-detail">
        <div class="ilf-detail-card__main">
          {% if node.field_featured_image.target_id and node.field_featured_image.entity %}
            <img
              class="ilf-detail-card__hero-image"
              src="{{ file_url(node.field_featured_image.entity.uri.value) }}"
              alt="{{ node.field_featured_image.alt ?: (label|render|striptags ~ ' image') }}"
            >
          {% endif %}
          {% if node.field_summary.value %}
            <p class="ilf-profile-summary">{{ node.field_summary.value|striptags }}</p>
          {% endif %}
          {{ content.body }}
        </div>
        <aside class="ilf-detail-card__aside" aria-label="Next steps">
          <h2>Next step</h2>
          <p>Use this update as another reason to request Fujitsu when comparing AC brands in Hawaii.</p>
          {{ content.field_external_link }}
          <a class="btn-main" href="/find-a-fujitsu-contractor">Find a Fujitsu Dealer</a>
          <a class="btn-main btn-outline" href="/resources">Review resources</a>
        </aside>
      </div>
    </div>
  </div>
</article>
