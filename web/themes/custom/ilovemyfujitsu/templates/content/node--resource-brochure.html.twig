<article{{ attributes.addClass('ilf-structured-node', 'ilf-structured-node--resource') }}>
  <header class="fujitsu-page-hero">
    <div class="container">
      <p class="fujitsu-eyebrow">Fujitsu Resource</p>
      <h1>{{ label }}</h1>
    </div>
  </header>

  <div class="fujitsu-page-body">
    <div class="container">
      <div class="ilf-detail-card ilf-resource-detail">
        <div class="ilf-detail-card__main">
          {% if resource_category %}
            <p class="ilf-kicker">{{ resource_category }}</p>
          {% endif %}
          {{ content.body }}
        </div>
        <aside class="ilf-detail-card__aside" aria-label="Resource actions">
          <h2>Use this before the estimate</h2>
          <p>Review the material, compare the Fujitsu advantage, then ask your contractor which Fujitsu option best fits your space.</p>
          {% if resource_file_size %}
            <div class="ilf-resource-meta ilf-resource-meta--large">
              <span class="ilf-resource-icon" aria-hidden="true">PDF</span>
              <span>{{ resource_file_size }}</span>
            </div>
          {% endif %}
          {% if resource_file_url %}
            <a class="btn-main" href="{{ resource_file_url }}">Download PDF</a>
          {% elseif node.field_resource_link.uri %}
            {% set resource_href = node.field_resource_link.uri starts with 'internal:' ? node.field_resource_link.uri|replace({'internal:': ''}) : node.field_resource_link.uri %}
            <a class="btn-main" href="{{ resource_href }}">{{ node.field_resource_link.title ?: 'Open resource' }}</a>
          {% endif %}
          <a class="btn-main btn-outline" href="/compare">Compare Fujitsu vs other brands</a>
          <a class="btn-main btn-outline" href="/find-a-fujitsu-contractor">Find a Fujitsu Dealer</a>
        </aside>
      </div>
    </div>
  </div>
</article>
