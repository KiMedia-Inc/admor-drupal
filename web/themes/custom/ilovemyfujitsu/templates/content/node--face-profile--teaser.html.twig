<article{{ attributes.addClass('ilf-teaser-card', 'ilf-teaser-card--profile') }}>
  {% if node.field_profile_image.target_id and node.field_profile_image.entity %}
    <img
      src="{{ file_url(node.field_profile_image.entity.uri.value) }}"
      alt="{{ node.field_profile_image.alt ?: (label|render|striptags ~ ' - Faces of Fujitsu') }}"
      loading="lazy"
    >
  {% endif %}
  <div class="ilf-teaser-card__body">
    <p class="ilf-teaser-card__type">Face of Fujitsu</p>
    <h2><a href="{{ url }}">{{ label }}</a></h2>
    {% if node.field_role.value %}
      <p class="ilf-teaser-card__role">{{ node.field_role.value }}</p>
    {% endif %}
    {% if node.field_summary.value %}
      <p>{{ node.field_summary.value|striptags }}</p>
    {% endif %}
    <a class="ilf-teaser-card__link" href="{{ url }}">Meet the face</a>
  </div>
</article>
