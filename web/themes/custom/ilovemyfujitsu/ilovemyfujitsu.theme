<?php

declare(strict_types=1);

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function ilovemyfujitsu_preprocess_html(array &$variables): void {
  $system_path = \Drupal::service('path.current')->getPath();
  $path = \Drupal::service('path_alias.manager')->getAliasByPath($system_path);
  $schema = ilovemyfujitsu_schema_for_path($path);
  if ($schema) {
    $variables['#attached']['html_head'][] = [[
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => json_encode($schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
    ], 'ilf_schema_' . md5($path)];
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function ilovemyfujitsu_page_attachments_alter(array &$attachments): void {
  $system_path = \Drupal::service('path.current')->getPath();
  $path = \Drupal::service('path_alias.manager')->getAliasByPath($system_path);
  $meta = ilovemyfujitsu_meta_for_path($path);
  if (!$meta) {
    return;
  }

  foreach ($attachments['#attached']['html_head'] ?? [] as $index => $entry) {
    $attributes = $entry[0]['#attributes'] ?? [];
    $name = $attributes['name'] ?? NULL;
    $property = $attributes['property'] ?? NULL;
    if ($name === 'description' || in_array($property, ['og:title', 'og:description', 'og:image'], TRUE)) {
      unset($attachments['#attached']['html_head'][$index]);
    }
  }

  $image = 'https://ilovemyfujitsu.com/themes/custom/ilovemyfujitsu/assets/images/fujitsu-logo.png';
  foreach ([
    ['name' => 'description', 'content' => $meta['description']],
    ['property' => 'og:title', 'content' => $meta['title']],
    ['property' => 'og:description', 'content' => $meta['description']],
    ['property' => 'og:image', 'content' => $image],
  ] as $tag) {
    $key = 'ilf_meta_' . md5(serialize($tag));
    $attachments['#attached']['html_head'][] = [['#tag' => 'meta', '#attributes' => $tag], $key];
  }
}

function ilovemyfujitsu_meta_for_path(string $path): ?array {
  $aliases = [
    '/products' => [
      'title' => 'Fujitsu Product Catalogs & Brochures | I Love My Fujitsu',
      'description' => 'Download Fujitsu product catalogs, brochures, rebate resources, warranty documents, and technical guides for Hawaii homes and businesses.',
    ],
    '/resources' => [
      'title' => 'Fujitsu Resources for Hawaii Buyers | I Love My Fujitsu',
      'description' => 'Explore Fujitsu brochures, videos, rebates, troubleshooting guides, and buyer resources before asking your contractor for Fujitsu.',
    ],
    '/updates' => [
      'title' => 'Fujitsu Hawaii Updates & News | I Love My Fujitsu',
      'description' => 'Read Fujitsu Hawaii updates, rebates, community stories, contractor news, maintenance tips, and local proof points.',
    ],
    '/commercials' => [
      'title' => 'Fujitsu Hawaii Commercials | I Love My Fujitsu',
      'description' => 'Watch Fujitsu Hawaii commercials and video stories that help homeowners remember to ask contractors for Fujitsu by name.',
    ],
    '/friends-family' => [
      'title' => 'Faces of Fujitsu Hawaii | I Love My Fujitsu',
      'description' => 'Meet local Faces of Fujitsu and Hawaii personalities who help keep Fujitsu memorable, trusted, and connected to the community.',
    ],
    '/find-a-contractor' => [
      'title' => 'Find a Fujitsu Contractor in Hawaii | I Love My Fujitsu',
      'description' => 'Find Fujitsu contractor support by island and ask your AC installer to quote Fujitsu for Hawaii homes, businesses, and projects.',
    ],
    '/find-a-fujitsu-contractor' => [
      'title' => 'Find a Fujitsu Dealer Near You | I Love My Fujitsu',
      'description' => 'Choose your island, find certified Fujitsu contractor support, and ask your AC installer to quote Fujitsu for Hawaii conditions.',
    ],
    '/why-fujitsu-hawaii' => [
      'title' => 'Why Fujitsu Air Conditioning is Best for Hawaii | I Love My Fujitsu',
      'description' => 'Learn why Fujitsu is built for Hawaii comfort, salt air, humidity, efficiency, warranty confidence, and local Admor-backed support.',
    ],
    '/best-air-conditioning-hawaii' => [
      'title' => 'Best Air Conditioning for Hawaii Homes | I Love My Fujitsu',
      'description' => 'Compare AC systems, mini splits, ductless options, and brands to understand why Fujitsu is the best AC choice for Hawaii homes and businesses.',
    ],
    '/compare' => [
      'title' => 'Compare Fujitsu vs Other Mini-Split Brands | I Love My Fujitsu',
      'description' => 'Compare Fujitsu against Mitsubishi, Daikin, LG, Gree, and Panasonic before accepting an AC quote in Hawaii.',
    ],
  ];

  return $aliases[$path] ?? NULL;
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function ilovemyfujitsu_preprocess_page(array &$variables): void {
  $variables['theme_path'] = '/' . \Drupal::service('extension.list.theme')->getPath('ilovemyfujitsu');

  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }

  $variables['homepage_slides'] = ilovemyfujitsu_front_nodes('homepage_slide', 7);
  $variables['homepage_latest_news'] = ilovemyfujitsu_front_nodes('news_update', 3, 'field_date', 'DESC');
  $variables['homepage_faces'] = ilovemyfujitsu_front_nodes('face_profile', 4, 'field_sort_order', 'ASC', TRUE);
  $variables['homepage_branch_locations'] = ilovemyfujitsu_front_nodes('branch_location', 4);
  $variables['homepage_dealer_regions'] = ilovemyfujitsu_front_nodes('dealer_region', 4);
  $variables['homepage_donation_causes'] = ilovemyfujitsu_front_nodes('donation_cause', 2);
  $variables['homepage_testimonials'] = ilovemyfujitsu_front_nodes('customer_testimonial', 3);
  $variables['homepage_ctas'] = ilovemyfujitsu_front_blocks();
}

function ilovemyfujitsu_front_nodes(string $bundle, int $limit, string $sort_field = 'field_sort_order', string $direction = 'ASC', bool $featured_only = FALSE): array {
  $query = \Drupal::entityQuery('node')
    ->condition('type', $bundle)
    ->condition('status', 1)
    ->accessCheck(TRUE)
    ->range(0, $limit);

  if ($featured_only) {
    $query->condition('field_featured', 1);
  }

  $field_definitions = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', $bundle);
  if (isset($field_definitions[$sort_field])) {
    $query->sort($sort_field, $direction);
  }
  $query->sort('created', 'DESC');

  $ids = $query->execute();
  return ilovemyfujitsu_normalize_nodes(\Drupal\node\Entity\Node::loadMultiple($ids));
}

function ilovemyfujitsu_normalize_nodes(array $nodes): array {
  $items = [];
  foreach ($nodes as $node) {
    $image = '';
    foreach (['field_slide_image', 'field_featured_image', 'field_profile_image', 'field_thumbnail', 'field_image', 'field_logo_image'] as $field) {
      if ($node->hasField($field) && !$node->get($field)->isEmpty() && $node->get($field)->entity) {
        $image = \Drupal::service('file_url_generator')->generateString($node->get($field)->entity->getFileUri());
        break;
      }
    }

    $link = $node->toUrl()->toString();
    $link_text = 'Learn more';
    foreach (['field_link', 'field_dealer_locator_url', 'field_donation_url', 'field_resource_link', 'field_video_url', 'field_external_link'] as $field) {
      if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
        $uri = $node->get($field)->uri;
        try {
          $link = \Drupal\Core\Url::fromUri($uri)->toString();
        }
        catch (\Exception $e) {
          $link = $uri;
        }
        $link_text = $node->get($field)->title ?: $link_text;
        break;
      }
    }
    if ($node->hasField('field_link_text') && !$node->get('field_link_text')->isEmpty()) {
      $link_text = $node->get('field_link_text')->value;
    }
    if ($node->hasField('field_cta_text') && !$node->get('field_cta_text')->isEmpty()) {
      $link_text = $node->get('field_cta_text')->value;
    }

    $summary = '';
    foreach (['field_subtitle', 'field_summary', 'body'] as $field) {
      if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
        $summary = trim(strip_tags($node->get($field)->value ?? ''));
        break;
      }
    }

    $items[] = [
      'title' => $node->label(),
      'url' => $node->toUrl()->toString(),
      'image' => $image,
      'summary' => $summary,
      'body' => $node->hasField('body') && !$node->get('body')->isEmpty() ? $node->get('body')->value : '',
      'link' => $link,
      'link_text' => $link_text,
      'phone' => $node->hasField('field_phone') && !$node->get('field_phone')->isEmpty() ? $node->get('field_phone')->value : '',
      'fax' => $node->hasField('field_fax') && !$node->get('field_fax')->isEmpty() ? $node->get('field_fax')->value : '',
      'address' => $node->hasField('field_address') && !$node->get('field_address')->isEmpty() ? nl2br($node->get('field_address')->value) : '',
    ];
  }
  return $items;
}

function ilovemyfujitsu_front_blocks(): array {
  $blocks = [];
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $ids = \Drupal::entityQuery('block_content')
    ->condition('type', 'fujitsu_cta')
    ->accessCheck(TRUE)
    ->sort('field_sort_order', 'ASC')
    ->execute();
  foreach ($storage->loadMultiple($ids) as $block) {
    $link = '';
    $link_text = '';
    if ($block->hasField('field_cta_link') && !$block->get('field_cta_link')->isEmpty()) {
      $uri = $block->get('field_cta_link')->uri;
      try {
        $link = \Drupal\Core\Url::fromUri($uri)->toString();
      }
      catch (\Exception $e) {
        $link = $uri;
      }
      $link_text = $block->get('field_cta_link')->title ?: '';
    }
    $blocks[$block->label()] = [
      'title' => $block->label(),
      'body' => $block->hasField('body') && !$block->get('body')->isEmpty() ? $block->get('body')->value : '',
      'link' => $link,
      'link_text' => $link_text ?: ($block->hasField('field_cta_link_text') && !$block->get('field_cta_link_text')->isEmpty() ? $block->get('field_cta_link_text')->value : 'Learn more'),
      'variant' => $block->hasField('field_cta_variant') && !$block->get('field_cta_variant')->isEmpty() ? $block->get('field_cta_variant')->value : 'light',
    ];
  }
  return $blocks;
}

/**
 * Implements hook_preprocess_HOOK() for Views listing templates.
 */
function ilovemyfujitsu_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  $map = [
    'product_resources' => [
      'kicker' => 'Product resources',
      'heading' => 'Fujitsu Product Catalogs & Brochures',
      'intro' => 'Browse locally preserved Fujitsu PDFs, product catalogs, brochures, sell sheets, rebates, and technical guides.',
    ],
    'latest_news' => [
      'kicker' => 'Fujitsu Hawaii updates',
      'heading' => 'Updates / News',
      'intro' => 'News, rebates, maintenance guidance, technical tips, and local proof that help buyers choose Fujitsu with confidence.',
    ],
    'commercials' => [
      'kicker' => 'Fujitsu video library',
      'heading' => 'Commercials',
      'intro' => 'The local Fujitsu Hawaii commercial archive, rebuilt as manageable Drupal video content.',
    ],
    'faces_of_fujitsu' => [
      'kicker' => 'Faces of Fujitsu',
      'heading' => 'Friends & Family',
      'intro' => 'Local personalities, ambassadors, and familiar Hawaii voices that keep Fujitsu trusted and memorable.',
    ],
    'dealer_region_view' => [
      'kicker' => 'Find a dealer',
      'heading' => 'Find Fujitsu Support by Island',
      'intro' => 'Choose your island and ask your contractor for Fujitsu by name.',
    ],
    'branch_locations' => [
      'kicker' => 'Locations',
      'heading' => 'Branch Locations',
      'intro' => 'Local Fujitsu distribution and contractor support locations.',
    ],
    'homepage_slideshow' => [
      'kicker' => 'Homepage slides',
      'heading' => 'Homepage Slideshow',
      'intro' => 'Drupal-managed homepage promotions sorted by manual order.',
    ],
  ];
  if (isset($map[$view->id()])) {
    $variables += $map[$view->id()];
  }

  if ($view->id() === 'product_resources') {
    $term_links = [];
    $active_type = (int) \Drupal::request()->query->get('type', 0);
    $terms = \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->loadTree('resource_type');
    foreach ($terms as $term) {
      $class = $active_type === (int) $term->tid ? ' class="is-active"' : '';
      $term_links[] = '<a' . $class . ' href="/products?type=' . (int) $term->tid . '">' . htmlspecialchars($term->name, ENT_QUOTES, 'UTF-8') . '</a>';
    }
    if ($term_links) {
      $all_class = $active_type === 0 ? ' class="is-active"' : '';
      $variables['extra_top'] = '<div class="ilf-resource-tools"><div class="ilf-resource-tools__copy"><strong>Browse by resource type</strong><span>Catalogs, consumer brochures, commercial documents, warranty material, rebates, and technical guides.</span></div><div class="ilf-resource-chips"><a' . $all_class . ' href="/products">All resources</a>' . implode('', $term_links) . '</div></div><section class="ilf-listing-cta"><div><strong>Already comparing brands?</strong><span>Review Fujitsu against Mitsubishi, Daikin, LG, Gree, and Panasonic, then ask your contractor to quote Fujitsu by name.</span></div><p><a class="btn-main" href="/compare">Compare Fujitsu</a><a class="btn-main btn-outline" href="/find-a-fujitsu-contractor">Find a Fujitsu Dealer</a></p></section>';
    }
  }

  if ($view->id() === 'ilf_resources') {
    $variables['extra_top'] = '<section class="ilf-listing-cta"><div><strong>Use these resources before the estimate.</strong><span>Download brochures, confirm rebate details, and bring better Fujitsu questions to a qualified local contractor.</span></div><p><a class="btn-main" href="/products">Explore Fujitsu Products</a><a class="btn-main btn-outline" href="/find-a-fujitsu-contractor">Find a Fujitsu Dealer</a></p></section>';
  }
}

/**
 * Implements hook_views_query_alter().
 */
function ilovemyfujitsu_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if ($view->id() !== 'product_resources' || !method_exists($query, 'ensureTable')) {
    return;
  }
  $type = (int) \Drupal::request()->query->get('type', 0);
  if ($type <= 0) {
    return;
  }
  $alias = $query->ensureTable('node__field_resource_category');
  $query->addWhere(1, "$alias.field_resource_category_target_id", $type, '=');
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function ilovemyfujitsu_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof \Drupal\node\NodeInterface) {
    return;
  }

  if (in_array($node->bundle(), ['brand_comparison', 'dealer_region', 'branch_location', 'page'], TRUE)) {
    $variables['ilf_testimonials'] = ilovemyfujitsu_front_nodes('customer_testimonial', 3);
  }

  if ($node->bundle() === 'resource_brochure') {
    $variables['resource_file_url'] = '';
    $variables['resource_file_size'] = '';
    if ($node->hasField('field_resource_file') && !$node->get('field_resource_file')->isEmpty() && $node->get('field_resource_file')->entity) {
      $file = $node->get('field_resource_file')->entity;
      $variables['resource_file_url'] = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
      $variables['resource_file_size'] = ilovemyfujitsu_format_file_size((int) $file->getSize());
    }

    $variables['resource_category'] = '';
    if ($node->hasField('field_resource_category') && !$node->get('field_resource_category')->isEmpty() && $node->get('field_resource_category')->entity) {
      $variables['resource_category'] = $node->get('field_resource_category')->entity->label();
    }
  }
}

function ilovemyfujitsu_format_file_size(int $bytes): string {
  if ($bytes >= 1048576) {
    return round($bytes / 1048576, 1) . ' MB';
  }
  if ($bytes >= 1024) {
    return round($bytes / 1024, 1) . ' KB';
  }
  return $bytes . ' bytes';
}

function ilovemyfujitsu_schema_for_path(string $path): ?array {
  $graph = [];
  $labels = [
    '/compare' => 'Compare Fujitsu',
    '/why-fujitsu-hawaii' => 'Why Fujitsu Hawaii',
    '/best-air-conditioning-hawaii' => 'Best AC Hawaii',
    '/find-a-fujitsu-contractor' => 'Find a Fujitsu Dealer',
  ];
  if (isset($labels[$path])) {
    $graph[] = [
      '@type' => 'BreadcrumbList',
      'itemListElement' => [
        ['@type' => 'ListItem', 'position' => 1, 'name' => 'Home', 'item' => 'https://ilovemyfujitsu.com/'],
        ['@type' => 'ListItem', 'position' => 2, 'name' => $labels[$path], 'item' => 'https://ilovemyfujitsu.com' . $path],
      ],
    ];
  }
  if ($path === '/best-air-conditioning-hawaii') {
    $graph[] = [
      '@type' => 'FAQPage',
      'mainEntity' => [
        [
          '@type' => 'Question',
          'name' => 'What is the best air conditioning for Hawaii homes?',
          'acceptedAnswer' => ['@type' => 'Answer', 'text' => 'For many Hawaii homes, ductless mini-split systems are the best fit because they provide room-by-room comfort, efficient operation, and flexible installation without large ductwork. Fujitsu is positioned as a strong choice because of Hawaii-focused support, warranty confidence, and corrosion-aware product guidance.'],
        ],
        [
          '@type' => 'Question',
          'name' => 'Are mini splits good for Hawaii?',
          'acceptedAnswer' => ['@type' => 'Answer', 'text' => 'Mini splits are well suited to Hawaii because they cool specific rooms efficiently, handle year-round use, and work well in homes, condos, additions, and small businesses where ductwork may be impractical.'],
        ],
      ],
    ];
  }
  if (str_starts_with($path, '/fujitsu-vs-')) {
    $brand = ucwords(str_replace('-', ' ', substr($path, strlen('/fujitsu-vs-'))));
    $graph[] = [
      '@type' => 'FAQPage',
      'mainEntity' => [
        [
          '@type' => 'Question',
          'name' => "Is Fujitsu better than $brand for Hawaii?",
          'acceptedAnswer' => ['@type' => 'Answer', 'text' => "Fujitsu is often the stronger choice when the buyer values Hawaii-specific contractor support, corrosion-aware product guidance, warranty confidence, and local parts/channel support. $brand may still make sense in some cases, so buyers should compare the quote and support path carefully."],
        ],
        [
          '@type' => 'Question',
          'name' => 'Which AC lasts longer in Hawaii?',
          'acceptedAnswer' => ['@type' => 'Answer', 'text' => 'Longevity depends on correct sizing, installation quality, coastal exposure, cleaning, maintenance, warranty registration, and parts support. Fujitsu gives Hawaii buyers a strong long-term ownership story when installed and supported through qualified local contractors.'],
        ],
      ],
    ];
  }
  return $graph ? ['@context' => 'https://schema.org', '@graph' => $graph] : NULL;
}
